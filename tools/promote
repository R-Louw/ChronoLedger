#!/usr/bin/env python3
"""Validate and atomically promote a durable user installation; never launches it."""
import datetime
import os
from pathlib import Path
import shutil
import subprocess

repo = Path(__file__).resolve().parent.parent
os.chdir(repo)
def run(*args):
    subprocess.run(args, check=True)
run('./tools/check')
run('./tools/check', 'memory')
build = repo / 'build-promote'
setup = ['meson', 'setup', str(build), '-Dbuildtype=release', '-Dwerror=true', '-Db_sanitize=none']
if (build / 'meson-private/coredata.dat').exists(): setup.append('--reconfigure')
run(*setup)
run('meson', 'compile', '-C', str(build))
run('meson', 'test', '-C', str(build), '--print-errorlogs')
base = Path.home() / '.local/share/chronoledger-install'
base.mkdir(parents=True, exist_ok=True)
release = base / ('release-' + datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f'))
release.mkdir()
(release / 'bin').mkdir()
shutil.copy2(build / 'chronoledger', release / 'bin/chronoledger')
# Shaders are compiled into GResource; the icon is the only external resource.
shutil.copy2(repo / 'data/icons/hicolor/scalable/apps/io.github.chronoledger.ChronoLedger.svg', release / 'icon.svg')
shutil.copy2(repo / 'docs/INSTALLATION.md', release / 'INSTALLATION.md')
linked = subprocess.check_output(['ldd', str(release / 'bin/chronoledger')], text=True)
if 'not found' in linked:
    raise SystemExit('Missing runtime dependency; installation unchanged:\n' + linked)
def link(target, destination):
    temporary = destination.with_name(destination.name + '.new')
    temporary.unlink(missing_ok=True)
    temporary.symlink_to(target)
    temporary.replace(destination)
current = base / 'current'
if current.is_symlink():
    link(os.readlink(current), base / 'previous')
link(release.name, current)
print('Promoted:', current / 'bin/chronoledger')
print('Previous release retained at:', base / 'previous')
